[Unit]
Description=Run the Tires Sync cycle every hour at :40 and the last morning check at 06:45

[Timer]
# every hour (the owner's word of 2026-10-20; before: every 6 hours)
OnCalendar=*-*-* *:40:00
# the last morning check, before Avito reads the feed at 07:00: positions that left the supplier's unload during the day were held until now (release 06:30)
OnCalendar=*-*-* 06:45:00
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
