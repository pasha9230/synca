[Unit]
Description=Hourly check of orders that hang in a stage; also the exact times of the return reminder (Mon, Wed, Fri 08:59) and of the 12:30 rules

[Timer]
OnCalendar=*:07:00
OnCalendar=Mon,Wed,Fri *-*-* 08:59:00 Europe/Moscow
OnCalendar=*-*-* 12:30:00 Europe/Moscow
Persistent=true
RandomizedDelaySec=0
AccuracySec=1s

[Install]
WantedBy=timers.target
