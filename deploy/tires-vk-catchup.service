[Unit]
Description=Tires Sync VK backstop (reads the points' conversations for messages VK did not deliver)
OnFailure=tires-alert@%n.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tires
Group=tires
UMask=0027
Environment=PYTHONPATH=/opt/tires-sync/app/src
Environment=TIRES_SECRET_KEY_FILE=/etc/tires-sync/secret.key
ExecStart=/opt/tires-sync/venv/bin/python -m tires_sync vk-catchup --db /var/lib/tires-sync/state.db
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tires-sync
