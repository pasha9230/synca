[Unit]
Description=Tires Sync Avito statistics (views, contacts, favourites by day; read only)
OnFailure=tires-alert@%n.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tires
Group=tires
UMask=0027
Environment=PYTHONPATH=/opt/tires-sync/app/src
Environment=TIRES_SECRET_KEY_FILE=/etc/tires-sync/secret.key
ExecStart=/opt/tires-sync/venv/bin/python -m tires_sync avito-stats --db /var/lib/tires-sync/state.db --days 7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tires-sync
