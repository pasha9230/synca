[Unit]
Description=Tires Sync orders - tasks of the "hangs in a stage" rules and the alert about the end of a reservation at the point (nothing is sent to clients)
OnFailure=tires-alert@%n.service

[Service]
Type=oneshot
User=tires
Group=tires
UMask=0027
Environment=PYTHONPATH=/opt/tires-sync/app/src
Environment=TIRES_SECRET_KEY_FILE=/etc/tires-sync/secret.key
ExecStart=/opt/tires-sync/venv/bin/python -m tires_sync orders-tick --db /var/lib/tires-sync/state.db
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tires-sync
